  lines:
  - speaker: {fileID: 11400000, guid: de57de16662efaa4b812124679233e38, type: 2}
    text: "\u82F1\u96C4\u4E0D\u662F\u88AB\u4F20\u8BF4\u9009\u4E2D\u7684\u3002\u662F\u81EA\u5DF1\u9009\u62E9\u4E0D\u9003\u3002"
  - speaker: {fileID: 11400000, guid: de57de16662efaa4b812124679233e38, type: 2}
    text: "\uFF08\u626F\u4E0B\u5FBD\u7AE0\uFF0C\u7838\u5728\u5730\u4E0A\u3002\uFF09"
  - speaker: {fileID: 11400000, guid: fc36acecf7b6e704f8ae7b21741f30e7, type: 2}
    text: "\u2026\u2026\u4F60\u7239\u5F53\u5E74\u6CA1\u6562\u7838\u3002"
  - speaker: {fileID: 11400000, guid: 408569c14d31c9d448f2ce6afd4d90c9, type: 2}
    text: "\u54FC\u3002\u6709\u70B9\u610F\u601D\u3002"
  - speaker: {fileID: 11400000, guid: b3d7a1f5c9e2408b7f2a6d1e4c8b3057, type: 2}
    text: "\u753B\u9762\u6DE1\u51FA\u3002\u5B57\u5E55\uFF1A\u201C\u82F1\u96C4\u4F20\u8BF4\u7B2C\u4E00\u6B21\u6CA1\u6709\u4EBA\u518D\u63D0\u8D77\u3002\u201D"
  - speaker: {fileID: 11400000, guid: b3d7a1f5c9e2408b7f2a6d1e4c8b3057, type: 2}
    text: "\u6E38\u620F\u6807\u9898\u51FA\u73B0\uFF1A\u300A\u82F1\u96C4\u7684\u8C0E\u8A00\u300B"
