  m_Script: {fileID: 11500000, guid: 8f95105fc5c53dd4bbbf618bf704e3ab, type: 3}
  m_Name: E1_VillageGate_Finale
  m_EditorClassIdentifier: 
  lines:
  - speaker: {fileID: 11400000, guid: e300c712cc68afb4da545da4f5df08ef, type: 2}
    text: "\u90FD\u529E\u5B8C\u4E86\uFF1F\u90A3\u2026\u2026\u8BE5\u4E0A\u8DEF\u4E86\u3002"
  - speaker: {fileID: 11400000, guid: fc36acecf7b6e704f8ae7b21741f30e7, type: 2}
    text: "\u5B69\u5B50\uFF0C\u4F60\u7239\u7684\u540D\u5B57\u4E5F\u5728\u5893\u56ED\u3002\u7B2C\u5341\u6B21\u3002"
  - speaker: {fileID: 11400000, guid: de57de16662efaa4b812124679233e38, type: 2}
    text: "\u6211\u7239\u4E5F\u662F\uFF1F"
  - speaker: {fileID: 11400000, guid: 408569c14d31c9d448f2ce6afd4d90c9, type: 2}
    text: "\u5FBD\u7AE0\u662F\u9910\u5238\u3002\u5730\u7262\u91CC\u90A3\u4E1C\u897F\u9760\u5B83\u8BA4\u4EBA\u3002\u6BCF\u4E2A\u6751\u90FD\u8FD9\u4E48\u9001\u4EBA\uFF0C\u51E0\u767E\u5E74\u4E86\u3002"
  - speaker: {fileID: 11400000, guid: de57de16662efaa4b812124679233e38, type: 2}
    text: "\u4F60\u4EEC\u90FD\u77E5\u9053\uFF1F"
  - speaker: {fileID: 11400000, guid: e300c712cc68afb4da545da4f5df08ef, type: 2}
    text: "\u77E5\u9053\u3002\u4F46\u4E0D\u8BF4\u3002\u8BF4\u4E86\uFF0C\u8C01\u8FD8\u53BB\uFF1F"
  - speaker: {fileID: 11400000, guid: fc36acecf7b6e704f8ae7b21741f30e7, type: 2}
    text: "\u6211\u513F\u5B50\u53BB\u4E86\u3002\u6211\u4E08\u592B\u53BB\u4E86\u3002\u73B0\u5728\u8F6E\u5230\u4F60\u4E86\u3002"
  - speaker: {fileID: 11400000, guid: 408569c14d31c9d448f2ce6afd4d90c9, type: 2}
    text: "\u6234\u4E0A\u5FBD\u7AE0\uFF0C\u8FDB\u5730\u7262\uFF0C\u5F53\u82F1\u96C4\u3002\u6216\u8005\u7838\u4E86\u5B83\uFF0C\u7559\u5728\u6751\u91CC\u5F53\u61E6\u592B\u3002\u9009\u5427\u3002"
  options:
  - optionText: "\u6234\u4E0A\u5FBD\u7AE0"
    nextDialogue: {fileID: 11400000, guid: 7a2c5e9b3d8f41069e3b7a1d5c8f2403, type: 2}
  - optionText: "\u7838\u788E\u5FBD\u7AE0"
    nextDialogue: {fileID: 11400000, guid: 1f6d9b3e8a2c47052d5b8f1c4a7e3906, type: 2}
