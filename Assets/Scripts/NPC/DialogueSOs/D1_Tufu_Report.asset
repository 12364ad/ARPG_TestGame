  m_Name: D1_Tufu_Report
  m_EditorClassIdentifier: 
  lines:
  - speaker: {fileID: 11400000, guid: 408569c14d31c9d448f2ce6afd4d90c9, type: 2}
    text: "\u77FF\u6E23\u62FF\u6765\u3002\u2026\u2026\u4F60\u5C0F\u5B50\u8FD0\u6C14\u597D\uFF0C\u6D3B\u7740\u56DE\u6765\u4E86\u3002\u4E0A\u4E00\u4E2A\u53BB\u5730\u7262\u7684\uFF0C\u8FDE\u9AA8\u5934\u90FD\u6CA1\u6361\u56DE\u6765\u3002"
  - speaker: {fileID: 11400000, guid: de57de16662efaa4b812124679233e38, type: 2}
    text: "\u5730\u7262\u91CC\u6709\u4EC0\u4E48\uFF1F"
  - speaker: {fileID: 11400000, guid: 408569c14d31c9d448f2ce6afd4d90c9, type: 2}
    text: "\u6709\u4EC0\u4E48\uFF1F\u6709\u540D\u5B57\u3002\u5899\u4E0A\u5168\u662F\u540D\u5B57\u3002\u6211\u6740\u732A\u8FD9\u4E48\u591A\u5E74\uFF0C\u6CA1\u89C1\u8FC7\u90A3\u4E48\u591A\u540D\u5B57\u3002"
  - speaker: {fileID: 11400000, guid: de57de16662efaa4b812124679233e38, type: 2}
    text: "\u90A3\u4E9B\u540D\u5B57\u662F\uFF1F"
  - speaker: {fileID: 11400000, guid: 408569c14d31c9d448f2ce6afd4d90c9, type: 2}
    text: "\u5386\u4EE3\u82F1\u96C4\u3002\u6216\u8005\u8BF4\uFF0C\u5386\u4EE3\u88AB\u9001\u8FDB\u53BB\u7684\u50BB\u5C0F\u5B50\u3002\u6751\u957F\u8BA9\u4F60\u6234\u5FBD\u7AE0\u4E86\u5427\uFF1F\u90A3\u73A9\u610F\u513F\u662F\u7ED9\u5730\u7262\u91CC\u7684\u4E1C\u897F\u6307\u8DEF\u7684\u3002"
  - speaker: {fileID: 11400000, guid: de57de16662efaa4b812124679233e38, type: 2}
    text: "\u6307\u8DEF\uFF1F"
  - speaker: {fileID: 11400000, guid: 408569c14d31c9d448f2ce6afd4d90c9, type: 2}
    text: "\u522B\u95EE\u4E86\u3002\u4F60\u4E09\u4E2A\u4EFB\u52A1\u90FD\u529E\u5B8C\u4E86\u5427\uFF1F\u53BB\u6751\u53E3\uFF0C\u5979\u4EEC\u5728\u7B49\u4F60\u3002"
  options: []
  requiredNPCs: []
  requiredItems:
