  lines:
  - speaker: {fileID: 11400000, guid: fc36acecf7b6e704f8ae7b21741f30e7, type: 2}
    text: "\u4F60\u53BB\u4E86\u2026\u2026\u770B\u5230\u963F\u5F3A\u7684\u540D\u5B57\u4E86\u5417\uFF1F"
  - speaker: {fileID: 11400000, guid: de57de16662efaa4b812124679233e38, type: 2}
    text: "\u770B\u5230\u4E86\u3002\u4E0B\u9762\u8FD8\u523B\u7740\u201C\u7B2C\u5341\u6B21\u201D\u3002"
  - speaker: {fileID: 11400000, guid: fc36acecf7b6e704f8ae7b21741f30e7, type: 2}
    text: "\u7B2C\u5341\u6B21\u2026\u2026\u6211\u4E08\u592B\u662F\u7B2C\u4E5D\u6B21\u3002\u4ED6\u4EEC\u90FD\u8BF4\u82F1\u96C4\u4F1A\u56DE\u6765\uFF0C\u53EF\u56DE\u6765\u7684\u53EA\u6709\u5FBD\u7AE0\u3002"
  - speaker: {fileID: 11400000, guid: de57de16662efaa4b812124679233e38, type: 2}
    text: "\u5FBD\u7AE0\uFF1F"
  - speaker: {fileID: 11400000, guid: fc36acecf7b6e704f8ae7b21741f30e7, type: 2}
    text: "\u6BCF\u4E2A\u79BB\u6751\u7684\u4EBA\u90FD\u6709\u3002\u6751\u957F\u8BF4\u90A3\u662F\u8363\u8000\u3002\u53EF\u6211\u603B\u89C9\u5F97\uFF0C\u90A3\u662F\u8BB0\u53F7\u3002"
  - speaker: {fileID: 11400000, guid: de57de16662efaa4b812124679233e38, type: 2}
    text: "\uFF08\u6C89\u9ED8\u3002\uFF09"
