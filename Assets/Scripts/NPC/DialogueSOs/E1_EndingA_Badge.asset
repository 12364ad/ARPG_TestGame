  lines:
  - speaker: {fileID: 11400000, guid: de57de16662efaa4b812124679233e38, type: 2}
    text: "\uFF08\u6C89\u9ED8\u7740\u6234\u4E0A\u5FBD\u7AE0\uFF0C\u8F6C\u8EAB\u8D70\u5411\u5730\u7262\u65B9\u5411\u3002\uFF09"
  - speaker: {fileID: 11400000, guid: e300c712cc68afb4da545da4f5df08ef, type: 2}
    text: "\u2026\u2026\u53C8\u4E00\u4E2A\u3002"
  - speaker: {fileID: 11400000, guid: b3d7a1f5c9e2408b7f2a6d1e4c8b3057, type: 2}
    text: "\u753B\u9762\u6DE1\u51FA\u3002\u5B57\u5E55\uFF1A\u201C\u82F1\u96C4\u4F20\u8BF4\u4ECD\u5728\u7EE7\u7EED\u3002\u201D"
  - speaker: {fileID: 11400000, guid: b3d7a1f5c9e2408b7f2a6d1e4c8b3057, type: 2}
    text: "\u6E38\u620F\u6807\u9898\u51FA\u73B0\uFF1A\u300A\u82F1\u96C4\u7684\u8C0E\u8A00\u300B"
