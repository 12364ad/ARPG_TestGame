  lines:
  - speaker: {fileID: 11400000, guid: e300c712cc68afb4da545da4f5df08ef, type: 2}
    text: "\u56DE\u6765\u5566\uFF1F\u85E4\u8513\u4E4B\u5FC3\u7ED9\u6211\u3002\u55EF\u2026\u2026\u54C1\u8D28\u4E0D\u9519\u3002\u8FD9\u679A\u82F1\u96C4\u5FBD\u7AE0\u4F60\u62FF\u7740\uFF0C\u6751\u957F\u4EA4\u4EE3\u7684\u3002\u6234\u4E0A\u5B83\uFF0C\u82F1\u96C4\u4E4B\u8DEF\u4F1A\u8BA4\u5F97\u4F60\u3002"
  - speaker: {fileID: 11400000, guid: de57de16662efaa4b812124679233e38, type: 2}
    text: "\u82F1\u96C4\u4E4B\u8DEF\uFF1F"
  - speaker: {fileID: 11400000, guid: e300c712cc68afb4da545da4f5df08ef, type: 2}
    text: "\u522B\u95EE\u90A3\u4E48\u591A\uFF0C\u5927\u5BB6\u90FD\u8FD9\u4E48\u6234\u3002"
  - speaker: {fileID: 11400000, guid: de57de16662efaa4b812124679233e38, type: 2}
    text: "\uFF08\u63A5\u8FC7\u5FBD\u7AE0\uFF0C\u5FBD\u7AE0\u5FAE\u5FAE\u53D1\u70EB\u3002\uFF09"
